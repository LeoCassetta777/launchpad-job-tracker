# Copy this file to .env and fill it in. .env is ignored by git, so secrets stay on this machine.

# --- App ---
# 1 = auto-reload when you edit code (use on your laptop). 0 on the Mac mini.
FLASK_DEBUG=1
PORT=5050
# Only listen on this computer. On the Mac mini, `tailscale serve` provides the https:// address.
HOST=127.0.0.1
# 1 = run reminders, backups, and the weekly coach here. Set 0 on the laptop once the
# Mac mini is the main copy, so you don't get every reminder twice.
RUN_SCHEDULER=1

# Where the database (and later, uploaded files and backups) live.
# Keep this OUTSIDE OneDrive: OneDrive syncing a live SQLite file can lock or corrupt it.
# Leave blank to use a "data" folder inside the project.
DATA_DIR=

# The address you open Launchpad at. The clipper bookmarklet sends pages here.
# Leave blank to use whatever address the browser used to open Settings.
APP_URL=

# --- AI (Phase 2) ---
# Create a key at https://console.anthropic.com -> API keys. Never share it or commit it.
ANTHROPIC_API_KEY=
# Fast, cheap model for turning brain dumps and postings into cards.
PARSE_MODEL=claude-haiku-5-5
# Stronger model for fit checks and the weekly coach (Phases 4-5).
SMART_MODEL=claude-sonnet-5-5

# --- Reminders (Phase 3) ---
# Gmail account that SENDS reminders, and its 16-character app password
# (create one at https://myaccount.google.com/apppasswords; needs 2-Step Verification).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Where reminders are SENT (your school inbox). Also editable in Settings.
NOTIFY_EMAIL=
# Phone push via ntfy. Anyone who knows the topic name can read it, so it's long and random.
# Subscribe to this exact topic in the ntfy phone app. Keep it secret.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# --- Optional login (Phase 6) ---
# Don't type these by hand: run `python set_password.py` on the Mac mini.
LAUNCHPAD_PASSWORD_HASH=
LAUNCHPAD_SECRET_KEY=
